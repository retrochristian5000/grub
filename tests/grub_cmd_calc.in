# tests for calc command

cmd='calc -s result 907 add 980 mod 1151; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 736; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -p 4 -H 123; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0x007b; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -B 0x007b; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0b1111011; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -O 0b1111011; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0173; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -D 0173; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 123; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -s result 0 pow 1; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -s result 12 pow 5; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 248832; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc 12 div 0; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "x$v" == "x0"; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc 0 pow 0; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "x$v" == "x0"; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc 0x01m; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "x$v" == "x0"; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc 081; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "x$v" == "x0"; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc 0b02; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "x$v" == "x0"; then echo "error: $cmd" >&2; exit 1; fi

# tests for increment command

cmd='set num=2; export num; increment num; echo $num'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 3; then echo "error: $cmd" >&2; exit 1; fi

cmd='set num=2; export num; increment num 5; echo $num'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 7; then echo "error: $cmd" >&2; exit 1; fi

cmd='set num=2; export num; increment -- num -1; echo $num'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 1; then echo "error: $cmd" >&2; exit 1; fi

cmd='increment -- num; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "$v" == 0; then echo "error: $cmd" >&2; exit 1; fi

# tests for decrement command

cmd='set num=2; export num; decrement num; echo $num'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 1; then echo "error: $cmd" >&2; exit 1; fi

cmd='set num=2; export num; decrement num 2; echo $num'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0; then echo "error: $cmd" >&2; exit 1; fi

cmd='decrement num; echo $?'
v=`echo "$cmd" | @builddir@/grub-shell 2> /dev/null |tail -1`
if test "$v" == 0; then echo "error: $cmd" >&2; exit 1; fi
