cmd='calc -s result 907 add 980 mod 1151; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 736; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -p 4 -H 123; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0x007b; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -B 0x007b; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0b1111011; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -O 0b1111011; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0173; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -D 0173; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 123; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -s result 0 pow 1; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 0; then echo "error: $cmd" >&2; exit 1; fi

cmd='calc -s result 12 pow 5; echo $result'
v=`echo "$cmd" | @builddir@/grub-shell`
if test "$v" != 248832; then echo "error: $cmd" >&2; exit 1; fi
